# Optional embedding cache. Set REDIS_URL= (empty) to disable it.
REDIS_URL=redis://127.0.0.1:6379/0
EMBEDDING_CACHE_TTL=604800

# Docker host ports. Internal service addresses are set in compose.yaml.
API_PORT=8000
UI_PORT=8501
MONITORING_PORT=8502
JUPYTER_PORT=8888

# Optional absolute path to existing Ollama models; otherwise a Docker volume is used.
# Windows example: OLLAMA_MODELS_STORAGE=C:/Users/YOUR_USER/.ollama/models
